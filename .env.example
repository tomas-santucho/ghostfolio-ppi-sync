PPI_API_URL=https://confirm-real-ppi-api.example
PPI_AUTHORIZED_CLIENT=your-authorized-client
PPI_CLIENT_KEY=your-client-key
PPI_PUBLIC_KEY=your-ppi-public-key
PPI_PRIVATE_KEY=your-ppi-private-key
PPI_ACCOUNT_ID=your-ppi-account-id
PPI_ACCOUNT_IDS=your-ppi-account-id
# Optional read-only PPI order lookup. Keep false unless historical orders are available.
PPI_ORDER_ENRICHMENT=false
GHOSTFOLIO_URL=https://ghostfolio.example
GHOSTFOLIO_ACCESS_TOKEN=your-ghostfolio-access-token
GHOSTFOLIO_SECURITY_TOKEN=your-ghostfolio-security-token
GHOSTFOLIO_ACCOUNT_ID=your-ghostfolio-account-id
# Optional import batch size. Positive integer from 1 to 500; defaults to 100.
GHOSTFOLIO_BATCH_SIZE=100
DRY_RUN=false
LOG_LEVEL=info
SYNC_FROM_DATE=2024-01-01
# Optional inclusive upper bound for a controlled historical range.
SYNC_TO_DATE=2024-01-31
BOOTSTRAP_HOLDINGS_FILE=./tests/fixtures/bootstrap-holdings.json
# Historical PPI imports begin on this UTC date; bootstrap holding dates must be earlier.
BOOTSTRAP_CUTOFF_DATE=2024-01-02
PPI_SYMBOL_OVERRIDES=[]
# Optional: enables DEPOSIT/WITHDRAWAL imports only through pre-created Ghostfolio
# MANUAL assets. All three USD buckets use ISO currency USD but remain separate assets.
PPI_CASH_ASSETS={"ARS":"GF_PPI_CASH_ARS","USD_GLOBAL":"GF_PPI_CASH_USD","USD_MEP":"GF_PPI_CASH_USD_MEP","USD_CCL":"GF_PPI_CASH_USD_CCL"}
